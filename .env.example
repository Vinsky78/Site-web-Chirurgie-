# URL publique du site (canonical, hreflang, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nom affiché du site (Éclaira par défaut ; marque et domaines encore à vérifier)
# NEXT_PUBLIC_SITE_NAME=Éclaira
# Stockage des demandes. "memory" uniquement pour démo/tests : les données sont perdues au redémarrage.
# Sans base configurée, la production refuse les demandes plutôt que de les perdre.
# LEAD_STORAGE=memory

# Base de données PostgreSQL (docker compose up -d pour une base locale)
# DATABASE_URL=postgres://chirurgie:chirurgie@localhost:5432/chirurgie
# Clés de chiffrement des champs sensibles : npm run keys:generate
# En production, elles viennent du gestionnaire de clés de l'hébergeur.
# LEAD_ENCRYPTION_KEYS=k1:<base64 32 octets>
# LEAD_ENCRYPTION_ACTIVE_KEY=k1
# LEAD_HMAC_KEY=<base64 32 octets>

# Espace pro et accès à /admin (Better Auth, double authentification obligatoire).
# Secret d'au moins 32 caractères : openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Comptes : npm run pro:create-user -- --email ... --name ... --role surgeon|assistant|staff [--surgeon <slug>]

# E-mails transactionnels (Brevo). Sans clé : affichés dans la console en développement, refusés en production.
# Désactiver le suivi des ouvertures et des clics dans le compte Brevo.
# BREVO_API_KEY=
# EMAIL_FROM=ne-pas-repondre@votre-domaine.fr
# EMAIL_FROM_NAME=Éclaira

# CMS Payload (back-office /admin). Secret : openssl rand -hex 32
# PAYLOAD_SECRET=
# Source des fiches : "cms" pour lire le back-office, sinon les fichiers de src/content
# CONTENT_SOURCE=cms
# Premier administrateur, lu uniquement par npm run cms:seed
# CMS_ADMIN_EMAIL=
# CMS_ADMIN_PASSWORD=
# CMS_ADMIN_NAME=
