NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Chirurgie Esthétique Europe

# Stockage des demandes : "memory" (développement) ou "postgres" (production).
# Postgres : base hébergée en UE chez un hébergeur certifié HDS uniquement.
LEAD_STORAGE=memory
# DATABASE_URL=postgres://user:password@host:5432/chirurgie

# Google Analytics 4 (laisser vide pour désactiver la mesure et le bandeau de consentement).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Référencement : vérification des propriétaires (optionnel)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Entité éditeur dans les données structurées (optionnel, publié seulement si renseigné)
# NEXT_PUBLIC_CONTACT_EMAIL=contact@exemple.fr
# NEXT_PUBLIC_SAME_AS=https://www.linkedin.com/company/xxx,https://www.instagram.com/xxx
