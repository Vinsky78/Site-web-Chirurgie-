{
  "name": "site-web-chirurgie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.mts",
    "leads:purge": "tsx --env-file-if-exists=.env.local scripts/leads-purge.mts",
    "keys:generate": "tsx scripts/generate-keys.mts",
    "pro:create-user": "tsx --env-file-if-exists=.env.local scripts/pro-create-user.mts",
    "cms:migrate": "payload migrate",
    "cms:migrate:create": "payload migrate:create",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:seed": "payload run scripts/cms-seed.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "graphql": "^16.14.2",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "payload": "^3.90.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "undici": "^7.30.0",
    "dompurify": "^3.4.16"
  }
}
